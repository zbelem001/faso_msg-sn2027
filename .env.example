# Copier ce fichier en .env et remplacer chaque valeur avant un déploiement réel.
# Sans .env, docker-compose.yml utilise des valeurs de démonstration.

POSTGRES_PASSWORD=
SYNAPSE_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
SYNAPSE_OIDC_SECRET=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Adresse d'écoute de Caddy : 127.0.0.1 (machine locale) ou 0.0.0.0 (réseau)
ADRESSE_ECOUTE=127.0.0.1
